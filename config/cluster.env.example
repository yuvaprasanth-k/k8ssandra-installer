# ==============================================================================
# cluster.env — settings for scripts/k8s-k8ssandra-setup.sh
#
#   cp config/cluster.env.example config/cluster.env     # cluster.env is git-ignored
#   vi config/cluster.env
#   sudo bash scripts/k8s-k8ssandra-setup.sh --role all --config config/cluster.env
#
# Any command-line flag overrides the value here. Every line is optional —
# commented-out lines use the default shown.
# ==============================================================================

# ── Nodes / SSH ───────────────────────────────────────────────────────────────
WORKERS="10.0.1.11,10.0.1.12,10.0.1.13"   # worker private IPs (joined over SSH)
SSH_USER=ec2-user                          # ubuntu on Ubuntu AMIs
SSH_KEY=/home/ec2-user/.ssh/cluster-key.pem
# SSH_PORT=22
# WORKER_READY_TIMEOUT=900                 # seconds

# ── Kubernetes ────────────────────────────────────────────────────────────────
# K8S_VERSION=1.36                         # minor version; 1.35-1.37 are supported upstream
# POD_CIDR=192.168.0.0/16                  # must not overlap your VPC
# SERVICE_CIDR=10.96.0.0/12
# ADVERTISE_ADDRESS=                       # default: control-plane private IP
# CONTROL_PLANE_ENDPOINT=                  # e.g. k8s-api.internal:6443 (an NLB) for future HA
# SCHEDULE_ON_CONTROL_PLANE=false          # true for a single-node lab

# ── Networking (CNI) ──────────────────────────────────────────────────────────
# CNI=calico                               # calico | custom | none
# CNI_MANIFEST=                            # file or URL, used when CNI=custom
# CALICO_VERSION=v3.33.0
# CALICO_ENCAP=VXLAN                       # VXLAN (open UDP 4789) | IPIP (open IP proto 4 + TCP 179)

# ── Storage ───────────────────────────────────────────────────────────────────
# STORAGE_CLASS=local-path                 # local-path | ebs-gp3 | name of an existing StorageClass
# STORAGE_SIZE=20Gi                        # per Cassandra node
# LOCAL_PATH_DIR=/opt/local-path-provisioner
# LOCAL_PATH_VERSION=v0.0.37
# EBS_CSI_VERSION=                         # aws-ebs-csi-driver chart version, empty = latest

# ── K8ssandra stack ───────────────────────────────────────────────────────────
# HELM_VERSION=v3.22.1                     # only installed if helm is missing
# CERT_MANAGER_VERSION=v1.21.3             # skipped if cert-manager is already installed
# OPERATOR_VERSION=1.33.0                  # k8ssandra-operator chart; empty = latest
# NAMESPACE=k8ssandra-operator
# CLUSTER_SCOPED=false

# ── Cassandra ─────────────────────────────────────────────────────────────────
# CLUSTER_NAME=cassandra-cluster
# CASSANDRA_VERSION=4.1.8                  # 4.1.x or 5.0.x
# CASSANDRA_IMAGE=                         # override the server image (private registry etc.)
# DC_NAME=dc1
# DC_SIZE=3                                # needs this many schedulable nodes
# HEAP_SIZE=2048M                          # ~1/4 to 1/2 of MEMORY
# CASSANDRA_CPU=2                          # pod CPU request
# CASSANDRA_MEMORY=8Gi                     # pod memory request + limit
# RACKS=none                               # none | zone (one rack per AZ) | us-east-1a,us-east-1b,us-east-1c
# SOFT_ANTI_AFFINITY=false                 # true allows >1 pod per node (needs CPU + MEMORY)
# CLUSTER_MANIFEST=                        # path to your own K8ssandraCluster YAML (overrides all of the above)
# SKIP_CLUSTER=false
# CLUSTER_READY_TIMEOUT=1800               # 0 = don't wait

# ── Addons (installed after the cluster is Ready) ─────────────────────────────
# ADDONS=monitoring,reaper,medusa
#
# Backups with in-cluster SeaweedFS or S3-compatible storage are handled by a
# separate script:  scripts/k8ssandra-backup-setup.sh --seaweedfs --medusa
# It reads the MEDUSA_* settings below plus:
# SEAWEEDFS_STORAGE_CLASS=local-path       # where SeaweedFS stores the backups
# SEAWEEDFS_SIZE=50Gi
# MEDUSA_BUCKET=my-cassandra-backups
# MEDUSA_REGION=us-east-1
# MEDUSA_PROVIDER=s3                       # s3 (AWS) | s3_compatible (MinIO, Wasabi, ...) | s3_rgw (Ceph)
# MEDUSA_HOST=                             # s3_compatible/s3_rgw only: endpoint host or IP, no http://
# MEDUSA_PORT=                             # e.g. 9000 (MinIO), 443 (HTTPS endpoints)
# MEDUSA_SECURE=true                       # false = plain HTTP to the endpoint
# MEDUSA_SSL_VERIFY=true                   # false = accept self-signed certificates
# MEDUSA_MAX_BACKUP_COUNT=                 # keep at most N backups (older ones purged)
# MEDUSA_CREDENTIALS_TYPE=credential-based # or role-based (instance profile / IRSA, no keys)
# MEDUSA_ACCESS_KEY=                       # only for credential-based — keep this file chmod 600
# MEDUSA_SECRET_KEY=
# MEDUSA_BACKUP_SCHEDULE="0 1 * * *"       # daily differential backup per DC (cron, UTC)
# GRAFANA_ADMIN_PASSWORD=                  # default: random, read it with
#                                          # kubectl -n k8ssandra-operator get secret prometheus-grafana -o jsonpath='{.data.admin-password}' | base64 -d
